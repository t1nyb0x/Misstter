{
  "manifest_version": 3,
  "name": "Misstter (t1nyb0x-fork)",
  "version": "1.2.0",
  "description": "Misstter (t1nyb0x-fork)",

  "action": {
    "default_icon": {
      "16": "icons/icon_16x16.png",
      "32": "icons/icon_32x32.png",
      "128": "icons/icon_128x128.png",
      "256": "icons/icon_256x256.png",
      "512": "icons/icon_512x512.png"
    },
    "default_title": "Misstter",
    "default_popup": "popup.html"
  },

  "background": {
    "service_worker": "js/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://pro.twitter.com/*",
        "https://x.com/*",
        "https://pro.x.com/*"
      ],
      "js": ["js/vendor.js", "js/content_script.js"]
    }
  ],

  "host_permissions": [
    "https://twitter.com/*",
    "https://pro.twitter.com/*",
    "https://x.com/*",
    "https://pro.x.com/*"
  ],
  "permissions": ["storage"],

  "web_accessible_resources": [
    {
      "resources": ["misskey_icon.png"],
      "matches": [
        "https://twitter.com/*",
        "https://pro.twitter.com/*",
        "https://x.com/*",
        "https://pro.x.com/*"
      ]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "{f491b6b5-155c-ec1c-88c2-093f3f18e299}",
      "strict_min_version": "116.0"
    },
    "gecko_android": {
      "strict_min_version": "116.0"
    }
  }
}
