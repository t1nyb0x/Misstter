{
    "manifest_version": 2,

    "name": "Misstter (t1nyb0x-fork)",
    "description": "Misstter (t1nyb0x-fork)",
    "version": "1.2.0",

    "browser_action": {
        "default_icon": "icon.png",
        "default_popup": "popup.html",
        "default_title": "Misstter"
    },

    "icons": {
        "16": "icons/icon_16x16.png",
        "32": "icons/icon_32x32.png",
        "128": "icons/icon_128x128.png",
        "256": "icons/icon_256x256.png",
        "512": "icons/icon_512x512.png"
    },

    "content_scripts": [
        {
            "matches": [
                "https://twitter.com/*",
                "https://pro.twitter.com/*",
                "https://x.com/*",
                "https://pro.x.com/*"
            ],
            "js": ["js/vendor.js", "js/content_script.js"]
        }
    ],

    "background": {
        "scripts": ["js/background.js"]
    },

    "permissions": ["storage"],

    "web_accessible_resources": ["misskey_icon.png"],

    "browser_specific_settings": {
        "gecko": {
            "id": "Misstter-fork@t1nyb0x",
            "strict_min_version": "120.0"
        },
        "gecko_android": {
            "strict_min_version": "120.0"
        }
    }
}
